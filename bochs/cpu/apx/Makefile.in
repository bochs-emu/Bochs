# Makefile for the cpu/apx component of bochs

@SUFFIX_LINE@

srcdir = @srcdir@
VPATH = @srcdir@
top_builddir    = ../..
top_srcdir      = @top_srcdir@

SHELL = @SHELL@

@SET_MAKE@

CC       = @CC@
CFLAGS   = @CFLAGS@ @GUI_CFLAGS@
CXX      = @CXX@
CXXFLAGS = @CXXFLAGS@ @GUI_CXXFLAGS@

#CFLAGS  = -Wall -Wstrict-prototypes -fomit-frame-pointer -fno-strict-aliasing -pipe -fno-strength-reduce -mpreferred-stack-boundary=2 -DCPU=686 -march=i686

LDFLAGS    = @LDFLAGS@
LIBS       = @LIBS@
RANLIB     = @RANLIB@

BX_INCDIRS = -I.. -I../.. -I$(srcdir)/.. -I$(srcdir)/../.. -I../../@INSTRUMENT_DIR@ -I$(srcdir)/../../@INSTRUMENT_DIR@

# Objects which are only used for APX code
APX_OBJS = \
	arith8.o \
	arith16.o \
	arith32.o \
	arith64.o \
	ccmp.o \
	cfcmov16.o \
	cfcmov32.o \
	cfcmov64.o \
	ctest.o \
	jmpabs.o \
	logical8.o \
	logical16.o \
	logical32.o \
	logical64.o \
	mult8.o \
	mult16.o \
	mult32.o \
	mult64.o \
	setcc.o \
	shift8.o \
	shift16.o \
	shift32.o \
	shift64.o \
	stack.o

all: libapx.a

.@CPP_SUFFIX@.o:
	$(CXX) @DASH@c $(BX_INCDIRS) $(CXXFLAGS) @CXXFP@$< @OFP@$@

.c.o:
	$(CC) @DASH@c $(CFLAGS) $(BX_INCDIRS) $< @OFP@$@


libapx.a: $(APX_OBJS)
	@RMCOMMAND@ libapx.a
	@MAKELIB@ $(APX_OBJS)
	$(RANLIB) libapx.a

clean:
	@RMCOMMAND@ *.o
	@RMCOMMAND@ *.a

dist-clean: clean
	@RMCOMMAND@ Makefile

